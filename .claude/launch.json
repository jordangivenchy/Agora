{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agorasphere",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "start:go"
      ],
      "port": 8081
    }
  ]
}
