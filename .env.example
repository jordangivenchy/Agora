# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (Dashboard → Settings → API). Server-only: used by the Apify
# webhook, the trait cron, and the response cache. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── LiveKit ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── AI providers (at least one required for the Agora assistant) ────────────
# Primary: Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Fallback: Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ── PostHog ─────────────────────────────────────────────────────────────────
# Project API key (public, used for event capture)
NEXT_PUBLIC_POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Personal API key + project id: used ONLY by the hourly cron to batch-read
# person properties into Supabase. Never called from the chat hot path.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# POSTHOG_API_HOST=https://us.posthog.com

# ── Apify ───────────────────────────────────────────────────────────────────
# Shared secret in the webhook URL: /api/webhook/apify?token=<this value>
APIFY_WEBHOOK_SECRET=
# API token, used to fetch dataset items when the webhook only sends a run id
APIFY_TOKEN=

# ── Cron auth ───────────────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes automatically.
CRON_SECRET=

# ── Audience overflow ───────────────────────────────────────────────────────
# Spectator ceiling for live rooms: at/above this many connected audience
# members, NEW audience joiners watch the room's HLS broadcast (free R2
# egress) instead of taking a LiveKit WebRTC seat. Stage roles always get
# WebRTC; nobody already connected is migrated. Server-side only.
# HLS_AUDIENCE_THRESHOLD=15
