{
  "expo": {
    "name": "AgoraSphere",
    "slug": "agorasphere",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "net.agorasphere.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AgoraSphere uses your microphone when you speak on a stage.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSCameraUsageDescription": "AgoraSphere uses your camera when you turn it on while speaking on a stage, and to take a photo for your profile or a post.",
        "NSPhotoLibraryUsageDescription": "AgoraSphere needs your photos to set a profile picture, a banner, or attach an image."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.agorasphere.app",
      "permissions": [
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "AgoraSphere needs your photos to set a profile picture, a banner, or attach an image.",
          "cameraPermission": "AgoraSphere uses your camera when you turn it on while speaking on a stage, and to take a photo for your profile or a post."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-blank.png",
          "imageWidth": 100,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "agorasphere",
    "backgroundColor": "#000000"
  }
}
